# Copie para .env (que fica fora do git) e preencha. Nunca faça commit do .env.

# Gemini (Google AI Studio → Get API key). O nível gratuito basta para os embeddings (temas repetidos).
# Só é usado para texto se um nicho tiver "llm": {"provedor": "gemini"}; com "antigravity" o texto sai
# do agy (login da assinatura Google AI Pro, sem chave).
GEMINI_API_KEY=

# Claude (console.anthropic.com). Opcional: só é usado se um nicho tiver "llm": {"provedor": "claude"}.
ANTHROPIC_API_KEY=

# ElevenLabs (elevenlabs.io → Profile → API keys). Gera a narração.
ELEVENLABS_API_KEY=

# A etapa de cenas roda o Claude Code (claude -p) com o login da sua assinatura.
# Com 1, ele passa a usar a ANTHROPIC_API_KEY acima e cobra pela API em vez da assinatura.
CLAUDE_CODE_USA_API_KEY=0
